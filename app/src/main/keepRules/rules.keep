# R8 rules for WarpTuner. AGP merges every file in src/main/keepRules.

# AmneziaWG: the Go backend calls back into Java through JNI and the config
# parser uses reflection-like lookups; keep the whole library intact.
-keep class org.amnezia.awg.** { *; }
-keepclasseswithmembernames class * {
    native <methods>;
}

# Debug and verbose logs are removed from release builds.
-assumenosideeffects class android.util.Log {
    public static int d(...);
    public static int v(...);
}
